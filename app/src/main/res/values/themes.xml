<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AlarmApp" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/app_background</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/app_background</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.AlarmApp.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AlarmApp.Dialog</item>

        <!-- Persian font (Vazirmatn) everywhere -->
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="textAppearanceButton">@style/TextAppearance.AlarmApp.Button</item>
        <item name="textAppearanceBody1">@style/TextAppearance.AlarmApp.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.AlarmApp.Body2</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.AlarmApp.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.AlarmApp.Subtitle2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.AlarmApp.Caption</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.AlarmApp.Headline6</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.AlarmApp.Headline5</item>
    </style>

    <style name="TextAppearance.AlarmApp.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.AlarmApp.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>

    <style name="Widget.AlarmApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ThemeOverlay.AlarmApp.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_cyan</item>
    </style>
</resources>
